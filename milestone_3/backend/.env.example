# ===============================================================
# Trakerz Milestone 3 - Environment Configuration
# ===============================================================
# Copy this file to .env and adjust variables as needed:
#   copy .env.example .env

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Storage Mode: "sqlite" (default local mode) or "firestore" (cloud mode)
STORAGE_MODE=sqlite

# SQLite Settings (Used when STORAGE_MODE=sqlite)
# Stored strictly inside milestone_3
SQLITE_DB_PATH=trakerz_m3.db

# Cloud Firestore Settings (Used when STORAGE_MODE=firestore)
# Path to Google Cloud Service Account JSON file
# IMPORTANT: Never commit your service account JSON file to Git!
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_PROJECT_ID=
FIRESTORE_COLLECTION=expenses
