# ===============================================================
# Trakerz Milestone 5 - Environment Configuration
# ===============================================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Storage Mode: "sqlite" (default local mode) or "firestore" (cloud mode)
STORAGE_MODE=sqlite

# SQLite Settings (Used when STORAGE_MODE=sqlite)
# Stored strictly inside milestone_5
SQLITE_DB_PATH=trakerz_m5.db

# Cloud Firestore Settings (Used when STORAGE_MODE=firestore)
GOOGLE_APPLICATION_CREDENTIALS=firebase-key.json
FIRESTORE_PROJECT_ID=
FIRESTORE_COLLECTION=expenses_m5

# AI Financial Assistant Settings (Google Gemini)
# Obtain an API key at: https://aistudio.google.com/apikey
# IMPORTANT: Never commit your real API key to Git!
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=20
