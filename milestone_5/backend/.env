HOST=0.0.0.0
PORT=8000
DEBUG=True

# Storage Mode: "sqlite" (default local mode) or "firestore" (cloud mode)
STORAGE_MODE=sqlite

# SQLite Settings (Used when STORAGE_MODE=sqlite)
# Stored strictly inside milestone_5
SQLITE_DB_PATH=trakerz_m5.db

# Cloud Firestore Settings (Used when STORAGE_MODE=firestore)
GOOGLE_APPLICATION_CREDENTIALS=firebase-key.json
FIRESTORE_PROJECT_ID=trakerz-52250
FIRESTORE_COLLECTION=expenses_m5

# AI Financial Assistant Settings (Google Gemini)
# Get a free API key from https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=20
